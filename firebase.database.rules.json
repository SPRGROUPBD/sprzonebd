{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
    },
    "deals": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
    },
    "coupons": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
    },
    "reviews": {
      ".read": true,
      "$productId": {
        "$reviewId": {
          ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true || (!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && data.child('uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['userName', 'uid', 'rating', 'comment', 'createdAt']) && !newData.hasChild('email') && !newData.hasChild('customerEmail') && !newData.hasChild('phone') && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5"
        }
      }
    },
    "settings": {
      "store": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
      },
      "delivery": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
      },
      "payment": {
        ".read": true,
        ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
      },
      "$other": {
        ".read": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)",
        ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
      }
    },
    "sms_inbox": {
      ".read": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)",
      ".write": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
    },
    "customers": {
      ".indexOn": ["email", "phone"],
      ".read": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)"
      }
    },
    "newsletter": {
      ".read": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)",
      ".write": true
    },
    "orders": {
      ".indexOn": ["uid", "customerEmail", "orderId"],
      ".read": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true || (query.orderByChild == 'uid' && query.equalTo == auth.uid) || (query.orderByChild == 'customerEmail' && query.equalTo == auth.token.email))",
      "$orderId": {
        ".read": "auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true || data.child('uid').val() == auth.uid || data.child('customerEmail').val() == auth.token.email)",
        ".write": "(auth != null && (auth.token.email == 'mail.sajjadahmed@gmail.com' || auth.token.admin === true)) || (!data.exists() && newData.exists()) || (auth != null && data.exists() && (data.child('uid').val() == auth.uid || data.child('customerEmail').val() == auth.token.email) && (data.child('status').val() == 'Pending' || data.child('status').val() == 'Placed') && newData.child('status').val() == 'Cancelled')"
      }
    }
  }
}
